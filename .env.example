# Copy to .env to override Docker Compose defaults. All values are optional.
POSTGRES_DB=medirecords
POSTGRES_USER=medirecords
POSTGRES_PASSWORD=medirecords
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4200
# JWT signing secret, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# Token lifetimes as ISO-8601 durations: short access token, longer rotating refresh token.
JWT_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
# Secure cookie flag. false only because Compose serves plain HTTP; true behind HTTPS.
COOKIE_SECURE=false
