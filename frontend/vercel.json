{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://medirecords-api.onrender.com/api/:path*" },
    { "source": "/swagger-ui/:path*", "destination": "https://medirecords-api.onrender.com/swagger-ui/:path*" },
    { "source": "/v3/api-docs/:path*", "destination": "https://medirecords-api.onrender.com/v3/api-docs/:path*" },
    { "source": "/v3/api-docs", "destination": "https://medirecords-api.onrender.com/v3/api-docs" },
    { "source": "/actuator/:path*", "destination": "https://medirecords-api.onrender.com/actuator/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
